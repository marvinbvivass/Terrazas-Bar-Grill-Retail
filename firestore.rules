rules_version = '2';

// =============================================================================
//  Reglas de Firestore · proyecto ventas-9a210
//
//  ⚠️  LAS REGLAS SON DEL PROYECTO ENTERO, NO DE UNA APLICACIÓN.
//
//  Aquí vivía también un bloque "heredado" con las rutas de la vieja
//  `dist-castillo` (`artifacts/**`, `public_data/**`, `users/**`). Se retiró
//  tras confirmar que ya nadie usa esa aplicación y que sus datos se borraron.
//  Si alguna vez reaparece, no bastará con reinstalarla: habrá que devolver
//  también sus rutas a este archivo.
//
//  La apiKey que va en el código del navegador NO protege nada: es pública por
//  diseño. Lo único que separa los datos del local de cualquiera que abra la
//  URL es este archivo.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function sesion() {
      return request.auth != null;
    }

    /*
     * Administrador según su propia ficha en `usuarios`.
     *
     * Si la ficha no existe, `get()` devuelve null y la regla falla, que es lo
     * correcto: sin ficha no hay ascenso. Cada `get()` dentro de una regla
     * cuenta como una lectura facturada, así que solo se usa donde hace falta
     * de verdad y no en las colecciones que se leen a cada rato.
     */
    function esAdmin() {
      return sesion()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador';
    }

    // ---------------------------------------------------------------------
    // Quién es quién
    //
    // Cada cuenta crea SU PROPIA ficha la primera vez que entra, y solo un
    // administrador puede cambiarle el papel a nadie. Sin la segunda mitad,
    // un encargado se ascendería solo con una línea en la consola del
    // navegador; esconderle el botón en la interfaz no sirve de nada.
    //
    // Nadie se borra: si una cuenta deja de trabajar aquí se desactiva en
    // Authentication, que es donde de verdad se le corta el paso.
    // ---------------------------------------------------------------------
    match /usuarios/{uid} {
      allow read:   if sesion();
      allow create: if sesion() && request.auth.uid == uid;
      allow update: if esAdmin();
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // Licorería · catálogo y configuración
    // ---------------------------------------------------------------------
    match /productos/{id}      { allow read, write: if sesion(); }
    match /presentaciones/{id} { allow read, write: if sesion(); }
    match /codigos/{id}        { allow read, write: if sesion(); }
    match /categorias/{id}     { allow read, write: if sesion(); }
    match /listas/{id}         { allow read, write: if sesion(); }
    match /precios/{id}        { allow read, write: if sesion(); }
    match /ubicaciones/{id}    { allow read, write: if sesion(); }
    match /metodosPago/{id}    { allow read, write: if sesion(); }
    match /existencias/{id}    { allow read, write: if sesion(); }
    match /config/{id}         { allow read, write: if sesion(); }

    // Los clientes de fiado llevan nombre, teléfono y deuda: nunca públicos.
    match /clientes/{id}       { allow read, write: if sesion(); }

    // ---------------------------------------------------------------------
    // Licorería · movimiento comercial
    //
    // Nada de esto se borra. Anular una venta es cambiarle el estado, no
    // hacerla desaparecer: si una venta puede borrarse, el cierre de un día
    // pasado puede cambiar sin que quede rastro de quién lo cambió.
    // ---------------------------------------------------------------------
    match /ventas/{id} {
      allow read:   if sesion();
      allow create: if sesion();
      allow update: if sesion();
      allow delete: if false;
    }

    match /abonos/{id} {
      allow read:   if sesion();
      allow create: if sesion();
      // Un cobro no se edita. Si estuvo mal, se corrige con otro movimiento.
      allow update, delete: if false;
    }

    match /movimientos/{id} {
      allow read:   if sesion();
      allow create: if sesion();
      allow update, delete: if false;
    }

  }
}
